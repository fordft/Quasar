#!/usr/bin/env python3
"""Scenario bench for Work: live lead runs through the signed probe, one table.

CARGO_TARGET_DIR defaults to /private/tmp/zephium-engine-target; WORK_BENCH_OUT
can override its work-bench evidence folder. Exit 0 from run means operational
completion (and applicable fixture checks), never semantic task correctness.

  scripts/work-bench build                  build the probe (run signs a private copy)
  scripts/work-bench run [scenario ...]     run (default: every default scenario)
  scripts/work-bench show [run.json]        print a run (default: the latest)
  scripts/work-bench compare a.json b.json  deltas of b against a
  scripts/work-bench baseline [run.json]    mark a run (default: the latest) as the baseline
  scripts/work-bench list                   scenarios
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime

REPO = os.path.realpath(os.path.join(os.path.dirname(__file__), ".."))
TARGET = os.path.abspath(os.path.join(REPO, os.environ.get("CARGO_TARGET_DIR", "/private/tmp/zephium-engine-target")))
PROBE = os.path.join(TARGET, "debug/macos-terra-agentic-probe")
OUT = os.path.abspath(os.path.join(REPO, os.environ.get("WORK_BENCH_OUT", os.path.join(TARGET, "work-bench"))))
SCHEMA = 2
SETUP_ENV = ("ZEPHIUM_PROBE_PAGE_MODEL", "ZEPHIUM_PROBE_SEARCH_ENGINE",
             "ZEPHIUM_PROBE_WORK_MEMORY", "ZEPHIUM_PROBE_WORK_MEMORY_CLEAR",
             "ZEPHIUM_PROBE_PROFILE", "ZEPHIUM_PROBE_SEEDED_PROFILE")
IDENTIFIER = "app.quasar.work-integration.probe"

# name -> (probe arguments, run by default, what it does)
SCENARIOS = {
    "lego": (["--live-lead", "lego"], True, "three Architecture sets from lego.com, price and pieces"),
    "trip": (["--live-lead", "trip"], True, "YC batch trip from Warsaw"),
    "compare": (["--live-lead", "compare"], True, "AWS, Vercel, Hetzner, Cloudflare for an AI SaaS"),
    "compilers": (["--live-lead", "compilers"], True, "free university compilers plan"),
    "explain": (["--live-lead", "explain"], True, "explain a pasted Rust function, no web"),
    "project": (["--live-lead", "project"], True, "what's in a small scratch repo"),
    "day": (["--loopback-site", "apps"], True, "plan the day against loopback Slack, Gmail, Calendar apps (scripted lead)"),
    "pricing": (["--live-lead", "pricing"], False, "how Linear, Height and Plane price"),
    "exam": (["--live-lead", "exam"], False, "prepare for an algorithms final (MIT 6.006)"),
    "tasks": (["--live-lead", "day"], False, "plan the day from seeded Zephium tasks (real lead)"),
    "save": (["--live-lead", "save"], False, "save an answer in a folder the run asks for as it works"),
    "best": (["--live-lead", "best"], False, "an open request: one finished piece of real work"),
}
TIMEOUT = 1000
STOP_ERRORS = ("Unauthorized", "MissingKey")


def die(message):
    print(f"work-bench: {message}", file=sys.stderr)
    sys.exit(1)


def sh(*command, **kwargs):
    return subprocess.run(command, cwd=REPO, **kwargs)


def check_signed(probe):
    shown = subprocess.run(["/usr/bin/codesign", "-dv", "--verbose=4", probe], capture_output=True, text=True)
    verified = subprocess.run(["/usr/bin/codesign", "--verify", "--strict", probe], capture_output=True)
    if shown.returncode or f"Identifier={IDENTIFIER}" not in shown.stderr.splitlines() or verified.returncode:
        die("private probe signature verification failed")
    return [line for line in shown.stderr.splitlines()
            if line.startswith(("Identifier=", "CDHash=", "TeamIdentifier=", "Authority="))]


def file_id(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def prepare_probe(directory):
    if not os.path.isfile(PROBE) or os.path.islink(PROBE):
        die("probe not built: run scripts/work-bench build")
    # Never sign or launch the mutable Cargo output. Verify the copied bytes,
    # then retain one read-only executable for every scenario in this run.
    probe = os.path.join(directory, "macos-terra-agentic-probe")
    source_hash = file_id(PROBE)
    shutil.copyfile(PROBE, probe)
    if file_id(probe) != source_hash or file_id(PROBE) != source_hash:
        die("Cargo probe changed while copying; retry after the build finishes")
    os.chmod(probe, 0o700)
    if sh(os.path.join(REPO, "scripts/sign-work-probe.sh"), probe).returncode:
        die("private probe signing failed")
    signature = check_signed(probe)
    os.chmod(probe, 0o500)
    return probe, file_id(probe), signature


def build():
    env = dict(os.environ, CARGO_TARGET_DIR=TARGET)
    if sh("cargo", "build", "-p", "zephium-terra-macos-probe", "--features", "durable-runtime", env=env).returncode:
        die("probe build failed")
    print(f"Built {PROBE}; run will sign and retain a private copy.")


RUN_LINE = re.compile(
    r"^lead-run: scenario=(\S+) request=(\d+) status=(\w+) wall_ms=(\d+) steps=(\d+) turns=(\d+) searches=(\d+) "
    r"pages=(\d+) parts=(\d+) parts_done=(\d+) objects=(\S*) revised=(\d+) inputs=(\d+) tokens=(\d+) "
    r"cost_micro_usd=(\d+) accounting=(\S+) asks=(\d+)$", re.M
)
PAGE_LINE = re.compile(r"phase=page site=\S* task=\S+ status=\w+ wall_ms=(\d+) calls=(\d+) actions=(\d+) tokens=(\d+) records=(\d+)")


def parse(name, output, code, wall):
    row = {"scenario": name, "exit": code, "process_ms": wall, "process_completed": code == 0}
    runs = RUN_LINE.findall(output)
    expected = "apps" if name == "day" else "day" if name == "tasks" else name
    count = 2 if name == "save" else 1
    row["request_evidence"] = [
        dict(scenario=r[0], request=int(r[1]), status=r[2], wall_ms=int(r[3]),
             steps=int(r[4]), turns=int(r[5]), searches=int(r[6]), read_steps=int(r[7]),
             parts=int(r[8]), parts_done=int(r[9]), objects=list(filter(None, r[10].split(","))),
             revised=int(r[11]), inputs=int(r[12]), tokens=int(r[13]),
             cost_micro_usd=int(r[14]), accounting=r[15], asks=int(r[16]))
        for r in runs
    ]
    evidence = row["request_evidence"]
    row["summaries_complete"] = (len(evidence) == count
        and all(r["scenario"] == expected for r in evidence)
        and [r["request"] for r in evidence] == list(range(1, count + 1)))
    row["status"] = evidence[-1]["status"] if evidence else "none"
    row["objects"] = [obj for r in evidence for obj in r["objects"]]
    for field in ("wall_ms", "steps", "turns", "searches", "read_steps", "parts", "parts_done", "tokens", "cost_micro_usd", "asks"):
        row[field] = sum(r[field] for r in evidence) if evidence else None
    if not evidence:
        row["wall_ms"] = wall
    row["accounting"] = [r["accounting"] for r in evidence]
    if not evidence or any(r["accounting"] == "None" for r in evidence):
        row["tokens"] = row["cost_micro_usd"] = None
    row["accounting_scope"] = "probe summary: first attempt per request; page diagnostics not added"
    pages = PAGE_LINE.findall(output)
    row["pages"] = len(pages) if pages else (row.get("read_steps") or 0)
    row["page_calls"] = sum(int(p[1]) for p in pages)
    row["page_actions"] = sum(int(p[2]) for p in pages)
    row["page_tokens"] = sum(int(p[3]) for p in pages)
    row["lead_turn_events"] = len(re.findall(r"(?:event|lead)=Turn \{", output))
    media = re.findall(r"lead-media: candidates=(\d+) admitted=(\d+) refused=(\d+) too_large=(\d+)", output)
    row["pictures"] = dict(zip(("candidates", "admitted", "refused", "too_large"),
                               (sum(int(m[i]) for m in media) for i in range(4))))
    row["failed_parts"] = [
        {"helper": p[0], "state": p[1], "need": p[2]}
        for p in re.findall(r"lead-part: helper=(\w+) state=(\w+) need=(\S+)", output)
        if p[1] != "Done"
    ]
    row["model_refused"] = re.findall(r"(?:event|lead)=ModelRefused \{ error: (\w+)", output)
    row["page_notes"] = re.findall(r'loopback-site: page status=Failed .*?note=Some\("([^"\n]*)"\)', output)
    row["run_failure"] = "run_failure=" in output
    row["run_completed"] = (code == 0 and row["summaries_complete"] and not row["run_failure"]
        and not row["failed_parts"] and not row["model_refused"]
        and all(r["status"] in ("NeedsReview", "Completed") and r["parts_done"] == r["parts"] for r in evidence))
    row["models"] = [dict(zip(("lead", "page", "light"), m)) for m in
                     re.findall(r"^lead-run: models lead=(\S+) page=(\S+) light=(\S+)$", output, re.M)]
    row["search_engines"] = re.findall(r"^lead-run: search engine=(\S+)$", output, re.M)
    row["model_setup_scope"] = "reported role IDs only; resolved provider/reasoning/revision unavailable"
    # The probe reports bounded fixture checks, not a semantic answer grader.
    # Keep them separate even when all checks and process execution succeed.
    row["fixture_predicates"] = {}
    if name == "day":
        checks = re.findall(r"check=apps asked=(\d+) named=(true|false) yours=(true|false) cookies=(true|false) read=(true|false) pages=\[[^\n]*\]", output)
        terminal = re.findall(r"check=Apps passed=(true|false)(?:$|\s)", output)
        if len(checks) == 1:
            asked, named, yours, cookies, read = checks[0]
            row["fixture_predicates"] = dict(asked_once=asked == "1", named=named == "true",
                yours=yours == "true", cookies=cookies == "true", seeded_fact_mentions=read == "true",
                probe_check=terminal == ["true"])
        row["fixture_verified"] = bool(row["fixture_predicates"]) and all(row["fixture_predicates"].values()) and row["run_completed"]
    elif name == "save":
        written = re.findall(r"^lead-run: scenario=save files_written=(\d+)$", output, re.M)
        row["fixture_predicates"] = {"nonempty_files": len(written) == 1 and int(written[0]) > 0}
        row["fixture_verified"] = all(row["fixture_predicates"].values()) and row["run_completed"]
    else:
        row["fixture_verified"] = None
    row["task_verified"] = None
    return row


def run_one(name, logs, probe, probe_hash):
    log_path = os.path.join(logs, f"{name}.log")
    if file_id(probe) != probe_hash:
        die("private probe bytes changed before launch")
    started = time.monotonic()
    with tempfile.TemporaryDirectory(prefix=f"work-bench-{name}-") as cwd, open(log_path, "w") as log:
        child = subprocess.Popen([probe, *SCENARIOS[name][0]], cwd=cwd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
        try:
            code = child.wait(timeout=TIMEOUT)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
            code = -9
        except KeyboardInterrupt:
            child.kill()
            child.wait()
            raise
    wall = int((time.monotonic() - started) * 1000)
    with open(log_path, errors="replace") as log:
        row = parse(name, log.read(), code, wall)
    row["probe"] = probe_hash
    row["probe_unchanged"] = file_id(probe) == probe_hash
    if not row["probe_unchanged"]:
        row["run_completed"] = False
        row["fixture_verified"] = False if row["fixture_verified"] is not None else None
    row["args"] = SCENARIOS[name][0]
    source = "work_site.rs" if name == "day" else "acceptance.rs"
    row["scenario_source"] = file_id(os.path.join(REPO, "crates/zephium-terra-macos-probe/src", source))
    row["log"] = log_path
    return row


def commit_id():
    head = sh("git", "rev-parse", "--short", "HEAD", capture_output=True, text=True).stdout.strip()
    dirty = bool(sh("git", "status", "--porcelain", "--untracked-files=no", capture_output=True, text=True).stdout.strip())
    return head + ("+dirty" if dirty else "")


HEAD = ["scenario", "run / task / fixture", "wall", "turns", "reads/calls", "tokens*", "cost*", "searches", "pics ok/refused", "failed parts (need/reason)"]


def result_label(row):
    if "run_completed" not in row:
        return "legacy/unverified"
    run = f"complete({row['status']})" if row["run_completed"] else f"incomplete({row['status']})"
    fixture = {True: "fixture-pass", False: "fixture-fail", None: "no-fixture-check"}[row.get("fixture_verified")]
    return f"{run} / task-unverified / {fixture}"


def cell(row):
    p = row["pictures"]
    return [
        row["scenario"],
        result_label(row),
        f"{row['wall_ms'] / 1000:.0f}s",
        str(row.get("turns") if row.get("turns") is not None else "-"),
        f"{row['pages']}/{row['page_calls']}",
        f"{row['tokens'] / 1000:.1f}k" if row.get("tokens") is not None else "unknown",
        f"${row['cost_micro_usd'] / 1e6:.3f}" if row.get("cost_micro_usd") is not None else "unknown",
        str(row.get("searches", "-")),
        f"{p['admitted']}/{p['refused']}" + (f" of {p['candidates']}" if p["candidates"] else ""),
        ", ".join(f"{f['helper']}:{f['need']}" for f in row["failed_parts"]) or "-",
    ]


def table(head, rows):
    widths = [max(len(head[i]), *(len(r[i]) for r in rows)) if rows else len(head[i]) for i in range(len(head))]

    def line(r):
        return "  ".join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip()

    return "\n".join([line(head), line(["-" * w for w in widths])] + [line(r) for r in rows])


def show(run):
    print(f"work-bench run {run['stamp']} at {run['commit']} probe {(run['rows'][0].get('probe') if run['rows'] else '')}")
    print(table(HEAD, [cell(r) for r in run["rows"]]))
    rows = run["rows"]
    print(f"\ntotal: {sum(r.get('run_completed') is True for r in rows)}/{len(rows)} runs complete; task correctness unverified")
    print("* Tokens/cost are reported first-attempt request summaries; missing usage is unknown, page diagnostics are not added.")
    bases = sorted({basis for row in rows for basis in row.get("accounting", [])})
    print(f"  Accounting bases: {', '.join(bases) or 'unknown'}")
    print("  Fixture passes cover only the listed predicates, not complete answer correctness.")


def load(path):
    with open(path) as f:
        return json.load(f)


def latest():
    runs = sorted(f for f in os.listdir(OUT) if re.fullmatch(r"\d{8}-\d{6}(?:-\d{6})?\.json", f)) if os.path.isdir(OUT) else []
    if not runs:
        die("no runs yet")
    return os.path.join(OUT, runs[-1])


METRICS = [
    ("wall", lambda r: r["wall_ms"] / 1000, "{:.0f}s"),
    ("turns", lambda r: r.get("turns", 0), "{:.0f}"),
    ("reads", lambda r: r["pages"], "{:.0f}"),
    ("calls", lambda r: r["page_calls"], "{:.0f}"),
    ("tokens", lambda r: r.get("tokens", 0) / 1000, "{:.1f}k"),
    ("cost", lambda r: r.get("cost_micro_usd", 0) / 1e6, "${:.3f}"),
    ("searches", lambda r: r.get("searches", 0), "{:.0f}"),
    ("pics", lambda r: r["pictures"]["admitted"], "{:.0f}"),
    ("failed", lambda r: len(r["failed_parts"]), "{:.0f}"),
]


def comparison_issue(a, b, base, row):
    if a.get("schema") != SCHEMA or b.get("schema") != SCHEMA:
        return "legacy evidence"
    for field in ("environment", "platform", "harness"):
        if field not in a or field not in b or a[field] != b[field]:
            return f"different/missing {field}"
    for field in ("args", "scenario_source", "models", "search_engines", "accounting", "accounting_scope"):
        if field not in base or field not in row or base[field] != row[field]:
            return f"different/missing {field}"
    if not row["models"] or not row["search_engines"] or not row["accounting"] or "None" in row["accounting"]:
        return "incomplete setup/usage evidence"
    return None


def compare(a_path, b_path):
    a, b = load(a_path), load(b_path)
    print(f"{os.path.basename(a_path)} ({a['commit']}) -> {os.path.basename(b_path)} ({b['commit']})")
    by = {r["scenario"]: r for r in a["rows"]}
    after = {r["scenario"]: r for r in b["rows"]}
    if len(by) != len(a["rows"]) or len(after) != len(b["rows"]):
        print("UNMATCHED: duplicate scenario rows")
        return 2
    rows, regressions, unmatched = [], [], False
    for name in dict.fromkeys([*by, *after]):
        base, row = by.get(name), after.get(name)
        issue = "added" if base is None else "missing" if row is None else comparison_issue(a, b, base, row)
        if issue:
            rows.append([name, f"UNMATCHED ({issue})"] + [""] * len(METRICS))
            unmatched = True
            continue
        result = "observed setup matched"
        if (base["run_completed"] and not row["run_completed"] or
                base.get("fixture_verified") is True and row.get("fixture_verified") is not True):
            regressions.append(f"{name}: run completion or fixture predicate regressed")
            result = "REGRESSED"
        line = [name, result]
        for _, get, fmt in METRICS:
            try:
                x, y = get(base), get(row)
                line.append("=" if abs(x - y) < 1e-9 else f"{fmt.format(x)} > {fmt.format(y)}")
            except TypeError:
                line.append("unknown")
        rows.append(line)
    print(table(["scenario", "comparison"] + [m[0] for m in METRICS], rows))
    print("\nDescriptive deltas only: task correctness and unreported model/provider settings remain unverified.")
    if regressions:
        print("\nregressions:\n  " + "\n  ".join(regressions))
    return 1 if regressions else 2 if unmatched else 0


def run(names):
    names = names or [n for n, (_, default, _) in SCENARIOS.items() if default]
    unknown = [n for n in names if n not in SCENARIOS]
    if unknown:
        die(f"unknown scenario {unknown[0]} (see: scripts/work-bench list)")
    if len(set(names)) != len(names):
        die("duplicate scenarios would overwrite evidence logs")
    os.makedirs(OUT, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    logs = os.path.join(OUT, stamp)
    os.mkdir(logs, 0o700)
    probe, probe_hash, signature = prepare_probe(logs)
    setup = {"schema": SCHEMA, "stamp": stamp, "commit": commit_id(),
             "cargo_target_dir": TARGET, "probe_path": probe, "signature": signature,
             "harness": file_id(__file__), "platform": list(os.uname()),
             "environment": {key: os.environ.get(key) for key in SETUP_ENV}}

    rows = []
    stopped = None
    for name in names:
        print(f"[{name}] running ...", flush=True)
        row = run_one(name, logs, probe, probe_hash)
        rows.append(row)
        print("  " + "  ".join(cell(row)[1:]), flush=True)
        if not row["probe_unchanged"]:
            stopped = "private probe bytes changed; stopped"
            break
        if any(e in STOP_ERRORS for e in row["model_refused"]) and not row["run_completed"]:
            stopped = f"provider refused the key ({', '.join(sorted(set(row['model_refused'])))}) in {name}; stopped"
            break
    result = dict(setup, rows=rows)
    if stopped:
        result["stopped"] = stopped
    path = os.path.join(OUT, f"{stamp}.json")
    with open(path, "w") as f:
        json.dump(result, f, indent=2)
    print()
    show(result)
    if stopped:
        print(f"\n{stopped}")
    print(f"\n{os.path.relpath(path, REPO)}")
    baseline = os.path.join(OUT, "baseline.json")
    if os.path.isfile(baseline):
        print()
        compare(baseline, path)
    return 0 if all(r["run_completed"] and r["fixture_verified"] is not False for r in rows) else 1


def main(argv):
    command = argv[1] if len(argv) > 1 else "run"
    rest = argv[2:]
    if command == "build":
        build()
    elif command == "run":
        sys.exit(run(rest))
    elif command == "show":
        show(load(rest[0] if rest else latest()))
    elif command == "compare" and len(rest) == 2:
        sys.exit(compare(*rest))
    elif command == "baseline":
        os.makedirs(OUT, exist_ok=True)
        source = rest[0] if rest else latest()
        shutil.copyfile(source, os.path.join(OUT, "baseline.json"))
        print(f"baseline: {os.path.relpath(source, REPO)}")
    elif command == "list":
        for name, (_, default, about) in SCENARIOS.items():
            print(f"{name:10} {'default' if default else 'on request':11} {about}")
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    try:
        main(sys.argv)
    except KeyboardInterrupt:
        sys.exit(130)
